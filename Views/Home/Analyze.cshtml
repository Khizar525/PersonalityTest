@model PersonalityResult
@{
    ViewData["Title"] = "Your Personality Result";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4">
                <h2 class="mb-0">Your Personality Type</h2>
            </div>
            <div class="card-body text-center p-5">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="mb-4">
                        <img src="@Model.ImagePath" alt="@Model.ImageName" class="img-fluid" style="max-height: 150px;" />
                    </div>
                }
                <h3 class="text-primary mb-1">@Model.Title</h3>
                <p class="text-muted mb-3">Drawn to: <strong>@Model.ImageName</strong></p>

                <div class="bg-light rounded-3 p-4 mb-4">
                    <p class="lead mb-0">@Model.Description</p>
                </div>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    @foreach (var trait in Model.Traits.Split(", "))
                    {
                        <span class="badge bg-secondary fs-6 px-3 py-2">@trait</span>
                    }
                </div>

                <hr class="my-4" />

                <a asp-action="Index" class="btn btn-outline-primary btn-lg px-5">
                    &#x2190; Take Test Again
                </a>
            </div>
            <div class="card-footer bg-light text-center text-muted py-3 small">
                This personality test is for entertainment purposes only.
            </div>
        </div>
    </div>
</div>
